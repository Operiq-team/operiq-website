---
interface Props {
  title: string;
  text: string;
  href?: string;
  label?: string;
}

const { title, text, href = "/kontakt?tema=forslag", label = "Be om løsningsforslag" } = Astro.props;
---

<aside class="cta-band">
  <div>
    <h2>{title}</h2>
    <p>{text}</p>
  </div>
  <a class="btn" href={href}>{label}</a>
</aside>
