---
interface Props {
  name: string;
  alt: string;
  width: number;
  height: number;
  sizes: string;
  priority?: boolean;
  widths?: number[];
}

const {
  name,
  alt,
  width,
  height,
  sizes,
  priority = false,
  widths = [640, 1024, 1600],
} = Astro.props;

const srcset = (ext: string) => widths.map((w) => `/media/${name}/${name}-${w}.${ext} ${w}w`).join(", ");
---

<picture>
  <source type="image/avif" srcset={srcset("avif")} sizes={sizes} />
  <source type="image/webp" srcset={srcset("webp")} sizes={sizes} />
  <img
    src={`/media/${name}/${name}-1024.jpg`}
    srcset={srcset("jpg")}
    sizes={sizes}
    alt={alt}
    width={width}
    height={height}
    loading={priority ? "eager" : "lazy"}
    fetchpriority={priority ? "high" : undefined}
    decoding="async"
  />
</picture>
