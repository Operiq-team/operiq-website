---
import { legalLine, site } from "../site";

const tel = site.phone.replace(/\s/g, "");
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-row">
      <a href="/" aria-label="Operiq, forside">
        <img src="/brand/logo-secure-white-sand.svg" alt="" width="168" height="22" />
      </a>
      <nav class="footer-links" aria-label="Bunn">
        <a href="/naeringsbygg">Næringsbygg</a>
        <a href="/lager-og-logistikk">Lager</a>
        <a href="/eiendomsportefoljer">Portefølje</a>
        <a href="/eksisterende-kameraanlegg">Eksisterende anlegg</a>
        <a href="/butikk">Kjeder</a>
        <a href="/kameraovervaking">Teknikk</a>
        <a href="/om-oss">Om oss</a>
        <a href="/personvern">Personvern</a>
        <a href="/kamera-info">Kamera på stedet</a>
        <a href={`mailto:${site.email}`} data-track="mailto">{site.email}</a>
        {
          site.phone && (
            <a href={`tel:${tel}`} data-track="tel">{site.phone}</a>
          )
        }
      </nav>
    </div>
    <div class="legal-line">
      <p>{legalLine}</p>
      <p>{site.coverage}</p>
    </div>
  </div>
</footer>
