  network: "M12 4v5M7 20h10M8 9h8v6H8V9Z",
  disk: "M5 7h14v10H5V7Zm0 3h14M8 14h2",
  phone: "M8 3h8a1 1 0 0 1 1 1v16a1 1 0 0 1-1 1H8a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1Zm4 14.5h.01",
  file: "M7 3h7l4 4v14H7V3Zm7 0v4h4M9 13h6M9 17h6",
