---
/**
 * Outlined OPERIQ | SECURE lockup (Plate 1.1). Paths are curves, not live text.
 * The wordmark is the default so a page that already shows symbol + name
 * does not repeat the Q. Pass withSymbol only when this lockup is the only mark.
 */
interface Props {
  line?: string;
  tone?: "on-dark" | "on-light";
  withSymbol?: boolean;
}

const { line = "SECURE", tone = "on-dark", withSymbol = false } = Astro.props;
const key = line.trim().toUpperCase();

const files: Record<string, { wordmark: string; logo: string }> = {
  "on-dark": {
    wordmark: "/brand/wordmark-secure-white-sand.svg",
    logo: "/brand/logo-secure-white-sand.svg",
  },
  "on-light": {
    wordmark: "/brand/wordmark-secure-black-sand.svg",
    logo: "/brand/logo-secure-black-sand.svg",
  },
};

const src = key === "SECURE" ? files[tone][withSymbol ? "logo" : "wordmark"] : "";
---

{
  src && (
    <img class="lockup" src={src} alt="Operiq Secure" width={withSymbol ? 320 : 280} height="40" />
  )
}
