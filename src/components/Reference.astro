---
/**
 * Godkjente referanser.
 * Kirkeristen: 26 kameraer, fiber, eget nett, under installasjon, ferdig desember 2026.
 * Hegdehaugsveien 36: ferdigstilt næringsbygg i Oslo. Ingen kameratall, ingen dato.
 * Ingen eierselskap, sitater eller bilder fra stedene.
 */
---

<div class="ref-list">
  <article class="ref glass" id="ref-hegdehaugsveien">
    <div class="ref-visual">
      <span class="pill"><i class="dot sand"></i>Illustrasjonsfoto</span>
    </div>
    <div class="ref-body">
      <p class="kicker">Referanse</p>
      <h2>Hegdehaugsveien 36</h2>
      <p>Kameraanlegg i næringsbygg, Oslo. Flere kameraer.</p>
      <dl class="specs">
        <div><dt>Status</dt><dd>Ferdigstilt</dd></div>
        <div><dt>Kameraer</dt><dd>Flere</dd></div>
      </dl>
      <p class="case-status">Ferdigstilt</p>
    </div>
  </article>

  <article class="ref glass" id="ref-kirkeristen">
    <div class="ref-visual">
      <span class="pill"><i class="dot sand"></i>Illustrasjonsfoto</span>
    </div>
    <div class="ref-body">
      <p class="kicker">Referanse</p>
      <h2>Kirkeristen, Oslo sentrum</h2>
      <p>Næringskvartal. 26 kameraer, ny fiberinfrastruktur og eget nettverk.</p>
      <p>
        Anlegget er forberedt for integrasjon mot byggets belysning (KNX) som del av piloten for aktiv avskrekking. Integrasjonen er planlagt.
      </p>
      <dl class="specs">
        <div><dt>Kameraer</dt><dd>26</dd></div>
        <div><dt>Nettverk</dt><dd>Fiber · eget nett</dd></div>
        <div><dt>Status</dt><dd>Under installasjon</dd></div>
        <div><dt>Ferdig</dt><dd>Desember 2026</dd></div>
      </dl>
      <p class="case-status">Under installasjon, ferdig desember 2026</p>
    </div>
  </article>
</div>
