---
import Base from "../layouts/Base.astro";
import CtaBand from "../components/CtaBand.astro";
import PageHero from "../components/PageHero.astro";
import { pathFor, ui, type Locale } from "../i18n";
import { legalLineFor, site } from "../site";

interface Props { locale?: Locale }
const { locale = "nb" } = Astro.props;
const t = ui(locale).about;
const tel = site.phone.replace(/\s/g, "");
---

<Base title={t.title} description={t.description} path={pathFor(locale, "about")} locale={locale}>
  <PageHero kicker={t.kicker} title={t.h} lead={t.lead} />
  <section class="section">
    <div class="container split">
      <div class="section-head"><h2>{t.h2}</h2></div>
      <div class="prose prose-embed">
        {t.body.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </div>
  </section>
  <section class="section section-follow">
    <div class="container split">
      <div class="section-head">
        <h2>{t.factsH}</h2>
        <p>{t.factsP}</p>
      </div>
      <dl class="plate facts">
        <div><dt>{t.labels[0]}</dt><dd translate="no">Operiq</dd></div>
        <div><dt>{t.labels[1]}</dt><dd translate="no">{site.legalName}</dd></div>
        <div><dt>{t.labels[2]}</dt><dd translate="no">{site.orgNr}</dd></div>
        <div><dt>{t.labels[3]}</dt><dd><a href={`mailto:${site.email}`} data-track="email_click" translate="no">{site.email}</a></dd></div>
        <div><dt>{t.labels[4]}</dt><dd>{ui(locale).coverageLine}</dd></div>
        <div><dt>{t.labels[5]}</dt><dd><a href={`tel:${tel}`} data-track="phone_click" translate="no">{site.phone}</a></dd></div>
      </dl>
    </div>
  </section>
  <section class="section section-tight">
    <div class="container">
      <p class="form-note legal-note" translate="no">{legalLineFor(locale)}</p>
      <CtaBand title={t.ctaTitle} text={t.ctaText} href={`${pathFor(locale, "contact")}?type=nytt`} label={ui(locale).home.proposal} />
    </div>
  </section>
</Base>
