---
/**
 * TODO(eier): Bekreft setningen om navneendring: selskapet heter fortsatt Godtbo Eiendom AS.
 * TODO(eier): Skal «MVA» stå sammen med org.nr? Det er utelatt til du bekrefter.
 */
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import CtaBand from "../components/CtaBand.astro";
import { legalLine, site } from "../site";

const title = "Om oss – Operiq";
const description =
  "Operiq Secure (Godtbo Eiendom AS, org.nr 927 212 056) leverer kameraovervåking for næringsbygg og butikk. Basert i Oslo, leverer i hele landet.";
---

<Base title={title} description={description} path="/om-oss">
  <PageHero
    kicker="Selskapet"
    title="Et lite selskap for bygg som skal virke"
    lead="Operiq Secure prosjekterer og monterer IP-kameraanlegg for næringsbygg og butikk."
  />

  <section class="section">
    <div class="container split">
      <div class="section-head">
        <h2>Hvem som står bak</h2>
      </div>
      <div class="prose prose-embed">
        <p>
          Sebastian Godtfredsen står bak Operiq. Bakgrunnen hans er prosjektledelse og drift av næringseiendom, og teknisk infrastruktur: fiber, nettverk og kameraovervåking.
        </p>
      </div>
    </div>
  </section>

  <section class="section section-follow">
    <div class="container split">
      <div class="section-head">
        <h2>Selskapsopplysninger</h2>
        <p>Utad heter vi Operiq. Juridisk navn er fortsatt {site.legalName}. Navneendring til Operiq er ikke registrert ennå.</p>
      </div>
      <dl class="plate facts">
        <div>
          <dt>Navn utad</dt>
          <dd>Operiq</dd>
        </div>
        <div>
          <dt>Juridisk navn</dt>
          <dd>{site.legalName}</dd>
        </div>
        <div>
          <dt>Org.nr</dt>
          <dd>{site.orgNr}</dd>
        </div>
        <div>
          <dt>E-post</dt>
          <dd><a href={`mailto:${site.email}`}>{site.email}</a></dd>
        </div>
        <div>
          <dt>Sted</dt>
          <dd>{site.coverage}</dd>
        </div>
        {
          site.phone && (
            <div>
              <dt>Telefon</dt>
              <dd>
                <a href={`tel:${site.phone.replace(/\s/g, "")}`}>{site.phone}</a>
              </dd>
            </div>
          )
        }
      </dl>
    </div>
  </section>

  <section class="section section-tight">
    <div class="container">
      <p class="form-note legal-note">{legalLine}</p>
      <CtaBand
        title="Ta kontakt"
        text="Befaring av kameraanlegg for næringsbygg eller butikk."
      />
    </div>
  </section>
</Base>
