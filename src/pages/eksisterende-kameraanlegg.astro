---
import Base from "../layouts/Base.astro";
import CtaBand from "../components/CtaBand.astro";
import PageHero from "../components/PageHero.astro";
import { pathFor, ui, type Locale } from "../i18n";

interface Props { locale?: Locale }
const { locale = "nb" } = Astro.props;
const t = ui(locale).existing;
---

<Base title={t.title} description={t.description} path={pathFor(locale, "existing")} locale={locale}>
  <PageHero kicker={t.kicker} title={t.h} lead={t.lead} />
  <section class="section section-follow">
    <div class="container">
      <h2>{t.lookH}</h2>
      <ul class="service-cards">{t.cards.map((card) => <li><h3>{card[0]}</h3><p>{card[1]}</p></li>)}</ul>
    </div>
  </section>
  <section class="section section-alt">
    <div class="container">
      <h2>{t.ownH}</h2>
      <p>{t.own1}</p>
      <p>{t.own2}</p>
      <ul class="checks">{t.checks.map((item) => <li>{item}</li>)}</ul>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <h2>{t.brandH}</h2>
      <p>{t.brandP}</p>
      <p><a class="link-arrow" href={pathFor(locale, "commercial")}>{t.links[0]}</a> <a class="link-arrow" href={pathFor(locale, "secure")}>{t.links[1]}</a></p>
    </div>
  </section>
  <section class="section section-tight">
    <div class="container">
      <CtaBand title={t.ctaTitle} text={t.ctaText} href={`${pathFor(locale, "contact")}?type=eksisterende`} label={t.cta} />
    </div>
  </section>
</Base>
