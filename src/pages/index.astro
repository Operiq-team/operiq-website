---
/**
 * TODO(eier): Bekreft forsiden. Kamera er eneste tilbud. Eiendomsdrift er tatt ut av navigasjon og innhold.
 */
import Base from "../layouts/Base.astro";
import Picture from "../components/Picture.astro";
import Icon from "../components/Icon.astro";
import Architecture from "../components/Architecture.astro";
import Reference from "../components/Reference.astro";
import { site } from "../site";

const title = "Operiq Secure – Moderne IP-kameraanlegg";
const description =
  "Operiq Secure prosjekterer og monterer moderne IP-kameraanlegg for næringsbygg og butikk. Du eier anlegget. Opptak lokalt. Montører i hele landet.";
---

<Base title={title} description={description} path="/">
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <p class="kicker">Operiq Secure</p>
        <h1>Moderne kameraanlegg. Lokalt i bygget.</h1>
        <p class="lead">
          For næringsbygg og butikk. Du eier anlegget, med lokalt opptak og visning på mobil. Bygget for aktiv avskrekking og automatisering.
        </p>
        <p class="hero-note"><a href="#neste">Avskrekking og agent er under utvikling, ikke i dagens leveranse.</a></p>
        <div class="actions">
          <a class="btn" href="/kontakt">Bestill gratis befaring</a>
          <a class="btn btn-ghost" href="/kameraovervaking">Se anlegget</a>
        </div>
        <ul class="trust">
          <li>Lokalt opptak</li>
          <li>Fjernvisning</li>
          <li>Fast pris</li>
          <li>Montører i hele landet</li>
        </ul>
      </div>
      <div class="stage frame">
        <Picture
          name="hero"
          alt="Domekameraer på en lys fasade"
          width="1200"
          height="900"
          sizes="(min-width: 800px) 46vw, 100vw"
          priority={true}
          widths={[640, 1024, 1600, 2400]}
        />
        <div class="panel" aria-hidden="true">
          <div class="panel-top">
            <span>Operiq Secure</span>
            <span>Illustrasjon</span>
          </div>
          <div class="tiles">
            <div class="tile">Fasade</div>
            <div class="tile">Inngang</div>
            <div class="tile">Lager</div>
          </div>
          <div class="chips">
            <span>Opptak lokalt</span>
            <span>NVR i bygget</span>
            <span>Visning på mobil</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="kicker">Hvem vi hjelper</p>
      <h2>Bygg, butikk og lager</h2>
      <div class="audience">
        <a class="audience-card" href="/kameraovervaking">
          <Picture
            name="facade"
            alt="Fasade på et næringsbygg"
            width="1200"
            height="900"
            sizes="(min-width: 800px) 30vw, 100vw"
          />
          <div>
            <h3>Gårdeiere og forvaltere</h3>
            <p>Anlegg tilpasset bygget, med dokumentasjon når det er levert.</p>
          </div>
        </a>
        <a class="audience-card" href="/butikk">
          <Picture
            name="shop"
            alt="Butikklokale med hyller"
            width="1200"
            height="900"
            sizes="(min-width: 800px) 30vw, 100vw"
          />
          <div>
            <h3>Butikk og kjeder</h3>
            <p>Samme oppsett i alle butikkene, rullet ut i bølger.</p>
          </div>
        </a>
        <a class="audience-card" href="/kameraovervaking">
          <Picture
            name="warehouse"
            alt="Lagerhall"
            width="1200"
            height="900"
            sizes="(min-width: 800px) 30vw, 100vw"
          />
          <div>
            <h3>Lager og næring</h3>
            <p>Dekning av hall, port og uteareal.</p>
          </div>
        </a>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <p class="kicker">Arkitektur</p>
      <h2>Slik er anlegget bygget</h2>
      <Architecture />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="kicker">Leveranse</p>
      <h2>Det som følger med</h2>
      <ul class="bento">
        <li>
          <Icon name="network" />
          <h3>Eget nettverk</h3>
          <p>Kameranettet er skilt fra det øvrige nettet i bygget.</p>
        </li>
        <li>
          <Icon name="disk" />
          <h3>Lokalt opptak</h3>
          <p>Opptakeren står i bygget. Opptakene er dine.</p>
        </li>
        <li>
          <Icon name="phone" />
          <h3>Fjernvisning på mobil</h3>
          <p>Se direkte og spill av, fra mobil eller PC.</p>
        </li>
        <li>
          <Icon name="cable" />
          <h3>Fiber og kabling</h3>
          <p>Cat6, og fiber der avstanden krever det.</p>
        </li>
        <li>
          <Icon name="file" />
          <h3>FDV-dokumentasjon</h3>
          <p>Underlag på det som er montert, når anlegget leveres.</p>
        </li>
        <li>
          <Icon name="check" />
          <h3>3 års garanti på kameraene</h3>
          <p>Garanti på øvrig utstyr følger produsent.</p>
        </li>
      </ul>
    </div>
  </section>

  <section class="section on-dark" id="neste">
    <div class="container">
      <p class="kicker">Under utvikling · Pilot</p>
      <h2>Neste generasjon: aktiv avskrekking</h2>
      <p class="measure">Vi bygger dette nå. Det er ikke en del av anlegget som leveres i dag.</p>
      <ul class="bento future">
        <li>
          <h3>Bygg og lys</h3>
          <p>Integrasjon med byggets systemer og belysning via KNX og buss, så lyset kan reagere på en hendelse.</p>
        </li>
        <li>
          <h3>Avskrekking</h3>
          <p>Lys og en talemelding som ber folk forlate området.</p>
        </li>
        <li>
          <h3>Agent</h3>
          <p>En AI-agent følger med på kamera, nett og opptaker, og setter i gang avskrekkingen.</p>
        </li>
      </ul>
      <ol class="flow" aria-label="Slik er piloten tenkt å virke">
        <li><span>01</span> Hendelse oppdaget</li>
        <li><span>02</span> Agent vurderer</li>
        <li><span>03</span> Lys og lyd aktiveres</li>
        <li><span>04</span> Varsel til eier</li>
      </ol>
      <p class="future-cta">
        Vil du være pilotkunde?
        <a href={`mailto:${site.email}`}>Ta kontakt</a>
        eller <a href="/kontakt">bestill en samtale</a>.
      </p>
    </div>
  </section>

  <section class="section section-alt" id="referanse">
    <div class="container">
      <Reference />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="kicker">Prosess</p>
      <h2>Fra befaring til dokumentasjon</h2>
      <ol class="timeline">
        <li>
          <span>01</span>
          <h3>Befaring</h3>
          <p>Vi ser på bygget og hva som skal dekkes.</p>
        </li>
        <li>
          <span>02</span>
          <h3>Prosjektering og fastpris</h3>
          <p>Plan og skriftlig fastpris før vi starter.</p>
        </li>
        <li>
          <span>03</span>
          <h3>Montering</h3>
          <p>Vi monterer og setter anlegget i drift.</p>
        </li>
        <li>
          <span>04</span>
          <h3>Test og dokumentasjon</h3>
          <p>Felles test, opplæring og FDV.</p>
        </li>
      </ol>
    </div>
  </section>

  <section class="section section-tight">
    <div class="container">
      <aside class="cta-band">
        <div>
          <h2>Bestill gratis befaring</h2>
          <p>Vi ser på bygget og sender et skriftlig tilbud. {site.coverage}.</p>
          <a class="cta-mail" href={`mailto:${site.email}`}>{site.email}</a>
        </div>
        <a class="btn" href="/kontakt">Bestill gratis befaring</a>
      </aside>
    </div>
  </section>
</Base>
