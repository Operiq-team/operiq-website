---
import Base from "../layouts/Base.astro";
import CtaBand from "../components/CtaBand.astro";
import PageHero from "../components/PageHero.astro";
import { pathFor, ui, type Locale } from "../i18n";

interface Props { locale?: Locale }
const { locale = "nb" } = Astro.props;
const t = ui(locale).commercial;
const contact = pathFor(locale, "contact");
---

<Base title={t.title} description={t.description} path={pathFor(locale, "commercial")} locale={locale}>
  <PageHero kicker={t.kicker} title={t.h} lead={t.lead} />
  <section class="section section-follow">
    <div class="container">
      <h2>{t.h2}</h2>
      <ul class="service-cards">
        {t.cards.map((card) => <li><h3>{card[0]}</h3><p>{card[1]}</p></li>)}
      </ul>
    </div>
  </section>
  <section class="section section-alt">
    <div class="container split">
      <div class="frame">
        <img src="/img/building-night.jpg" alt={t.alt} width="1200" height="900" loading="lazy" decoding="async" />
      </div>
      <div>
        <h2>{t.h3}</h2>
        <p>{t.p1}</p>
        <p>{t.p2}</p>
        <p>{t.p3}</p>
        <p><a class="link-arrow" href={pathFor(locale, "existing")}>{t.existingLink}</a></p>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <h2>{t.how}</h2>
      <ol class="how-steps">
        {t.steps.map((step, index) => <li><span>{String(index + 1).padStart(2, "0")}</span><h3>{step[0]}</h3><p>{step[1]}</p></li>)}
      </ol>
      <h2>{t.zonesH}</h2>
      <ul class="checks">{t.zones.map((zone) => <li>{zone}</li>)}</ul>
      <p>{t.zonesP}</p>
      <p>
        <a class="link-arrow" href={pathFor(locale, "warehouse")}>{t.links[0]}</a>
        <a class="link-arrow" href={pathFor(locale, "portfolio")}>{t.links[1]}</a>
        <a class="link-arrow" href={pathFor(locale, "existing")}>{t.links[2]}</a>
      </p>
      <p>{t.legal} <a class="link-arrow" href={pathFor(locale, "privacy")}>{t.privacy}</a></p>
    </div>
  </section>
  <section class="section section-tight">
    <div class="container">
      <CtaBand title={t.ctaTitle} text={t.ctaText} href={`${contact}?type=eksisterende`} label={t.cta} />
      <p><a class="link-arrow" href={`${contact}?type=nytt`} data-track="cta" data-track-type="nytt">{t.newLink}</a></p>
    </div>
  </section>
</Base>
