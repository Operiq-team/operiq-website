---
/**
 * TODO(eier): Bekreft leveranselisten: IP-kameraer, kabling, fiber, segmentert nett, lokal NVR, UPS, fjernvisning, valgfri adgangskontroll.
 * TODO(eier): Bekreft at person- og kjøretøydeteksjon og perimetervern kan stå i spesifikasjonen.
 * TODO(eier): Bekreft om underleverandører skal nevnes. Ingen navn er brukt.
 * TODO(eier): Bekreft at kunden er behandlingsansvarlig, og at Operiq ikke overtar ansvaret.
 */
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import Steps from "../components/Steps.astro";
import CtaBand from "../components/CtaBand.astro";
import Reference from "../components/Reference.astro";

const title = "Kameraanlegg du eier selv – Operiq Secure";
const description =
  "Operiq Secure prosjekterer og monterer IP-kameraanlegg med eget nett og lokalt opptak. Du eier anlegget. Fast pris etter befaring. 3 års garanti på kameraene.";

const steps = [
  { title: "Befaring", text: "Vi går gjennom bygget, dekning, føringsveier og nett." },
  { title: "Prosjektering og fastpris", text: "Kamera- og nettplan, og skriftlig fastpris." },
  { title: "Montering", text: "Operiq følger monteringen til anlegget er i drift." },
  { title: "Test og dokumentasjon", text: "Felles test, opplæring og FDV." },
];
---

<Base title={title} description={description} path="/kameraovervaking">
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <p class="kicker">Operiq Secure</p>
        <h1>Kameraanlegg du eier selv</h1>
        <p class="lead">
          Vi prosjekterer nett og montering, og setter opp lokal opptaker i bygget. Montører i hele landet.
        </p>
        <div class="actions">
          <a class="btn" href="/kontakt">Be om befaring</a>
        </div>
      </div>
      <div class="frame">
        <img src="/img/facade-night.jpg" alt="Kameraer på et bygg i kveldslys" width="1200" height="900" />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <ul class="service-cards">
        <li>
          <h3>Du eier anlegget</h3>
          <p>Opptakene ligger lokalt. Fjernvisning følger med.</p>
        </li>
        <li>
          <h3>Fast pris før vi starter</h3>
          <p>Befaring, deretter skriftlig fastpris.</p>
        </li>
        <li>
          <h3>Én kontakt</h3>
          <p>Du forholder deg til Operiq fra befaring til dokumentasjon.</p>
        </li>
      </ul>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <p class="kicker">Leveranse</p>
      <h2>Dette leveres</h2>
      <ul class="icon-grid">
        <li><Icon name="camera" /><div><h3>Kameraer</h3><p>IP-kameraer, valgt etter dekning og lys.</p></div></li>
        <li><Icon name="cable" /><div><h3>Kabling</h3><p>Cat6, og fiber der avstanden krever det.</p></div></li>
        <li><Icon name="network" /><div><h3>Nett</h3><p>Eget kameranett, skilt fra det øvrige nettet.</p></div></li>
        <li><Icon name="disk" /><div><h3>Opptak</h3><p>Lokal opptaker i bygget, med avspilling og eksport.</p></div></li>
        <li><Icon name="phone" /><div><h3>Visning</h3><p>Fjernvisning på mobil og PC.</p></div></li>
        <li><Icon name="file" /><div><h3>Dokumentasjon</h3><p>FDV og samsvarserklæringer ved overlevering.</p></div></li>
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="kicker">Nett og sikkerhet</p>
      <h2>Eget nett i bygget</h2>
      <ul class="service-cards pairs">
        <li>
          <h3>PoE og eget segment</h3>
          <p>Kameranettet er et eget segment, skilt fra det øvrige nettet i bygget. Switchene er PoE.</p>
        </li>
        <li>
          <h3>Lukket som utgangspunkt</h3>
          <p>Porter åpnes ikke mot internett som utgangspunkt. Fjernvisning avklares i prosjekteringen.</p>
        </li>
        <li>
          <h3>Lokal opptaker</h3>
          <p>NVR-en står i bygget. Opptak, avspilling og eksport skjer lokalt.</p>
        </li>
        <li>
          <h3>Fastvare i service</h3>
          <p>Oppdatering av fastvare inngår i service.</p>
        </li>
      </ul>
      <details class="fold">
        <summary>Mer i spesifikasjonen</summary>
        <ul>
          <li>IP-kameraer: dome, panorama og PTZ, valgt etter dekning og lys.</li>
          <li>Reservestrøm (UPS) ved korte strømbrudd.</li>
          <li>Varsling ved person og kjøretøy, og perimetervern, der kameraene støtter det.</li>
          <li>Adgangskontroll kan tas med der det trengs.</li>
        </ul>
      </details>
    </div>
  </section>

  <section class="section section-alt" id="referanse">
    <div class="container">
      <Reference />
    </div>
  </section>

  <figure class="band">
    <img src="/img/fiber-night.jpg" alt="Fiberkabler i et teknisk rack" width="1600" height="900" />
  </figure>

  <section class="section">
    <div class="container">
      <h2>Fra befaring til ferdig anlegg</h2>
      <Steps steps={steps} />
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <h2>Når anlegget overleveres</h2>
      <ul class="checks">
        <li>Felles funksjonstest</li>
        <li>Opplæring av dem som skal bruke anlegget</li>
        <li>Administratortilgang til deg</li>
        <li>FDV-dokumentasjon</li>
        <li>Kameraene har 3 års garanti. Garanti på øvrig utstyr følger produsent.</li>
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="note">
        <h2>Du er behandlingsansvarlig</h2>
        <p>
          Vi leverer oppsett og dokumentasjon for skilting, lagringstid og tilgang. Operiq utleverer ikke opptak.
          <a href="/kamera-info">Informasjon til dem som blir filmet</a>.
        </p>
      </div>
      <h2>Spørsmål</h2>
      <details class="fold">
        <summary>Hva koster det?</summary>
        <p>Fast pris etter befaring. Tilbudet er skriftlig.</p>
      </details>
      <details class="fold">
        <summary>Må jeg ha abonnement?</summary>
        <p>Du eier anlegget, og opptakene ligger i bygget. Om en lisens kommer i tillegg, avhenger av produsent og system. Service når du vil ha det.</p>
      </details>
      <details class="fold">
        <summary>Hva dekker garantien?</summary>
        <p>Kameraene har 3 års garanti. Garanti på øvrig utstyr følger produsent.</p>
      </details>
      <details class="fold">
        <summary>Leverer dere utenfor Oslo?</summary>
        <p>Montører i hele landet. Operiq er basert i Oslo.</p>
      </details>
      <details class="fold">
        <summary>Hvem eier opptakene?</summary>
        <p>Du eier anlegget og er behandlingsansvarlig for overvåkingen.</p>
      </details>
    </div>
  </section>

  <section class="section section-tight">
    <div class="container">
      <CtaBand
        title="Befaring. Deretter fast pris."
        text="Si ifra om bygget. Vi avtaler tid og sender tilbud etterpå."
      />
    </div>
  </section>
</Base>
