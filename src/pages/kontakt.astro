---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import { pathFor, ui, type Locale } from "../i18n";
import { site } from "../site";

interface Props { locale?: Locale }
const { locale = "nb" } = Astro.props;
const t = ui(locale).contact;
const tel = site.phone.replace(/\s/g, "");
---

<Base title={t.title} description={t.description} path={pathFor(locale, "contact")} locale={locale}>
  <PageHero kicker={t.kicker} title={t.h} lead={t.lead} />
  <section class="section section-follow">
    <div class="container contact-grid">
      <aside class="contact-aside">
        <h2>{t.direct}</h2>
        <p>{t.email}<br /><a href={`mailto:${site.email}`} data-track="mailto" translate="no">{site.email}</a></p>
        <p>{t.place}<br />{ui(locale).coverageLine}</p>
        <p>{t.phone}<br /><a href={`tel:${tel}`} data-track="tel" translate="no">{site.phone}</a></p>
        <p>{t.aside}</p>
      </aside>
      <form id="contact-form" method="post" action="/api/contact" data-mode={site.contactMode} data-email={site.email} data-locale={locale}>
        <div class="form-row two">
          <label><span>{t.name}</span><input name="name" type="text" autocomplete="name" required maxlength="120" /></label>
          <label><span>{t.company}</span><input name="company" type="text" autocomplete="organization" maxlength="160" /></label>
        </div>
        <div class="form-row two">
          <label><span>{t.emailField}</span><input name="email" type="email" autocomplete="email" required maxlength="160" /></label>
          <label><span>{t.phoneOpt}</span><input name="phone" type="tel" autocomplete="tel" maxlength="40" /></label>
        </div>
        <div class="form-row two">
          <label><span>{t.location}</span><input name="location" type="text" maxlength="240" /></label>
          <label>
            <span>{t.property}</span>
            <select name="propertyType">
              <option value="">{t.propertyPh}</option>
              <option value="naering">{t.properties[0]}</option>
              <option value="lager">{t.properties[1]}</option>
              <option value="portefolje">{t.properties[2]}</option>
              <option value="butikk">{t.properties[3]}</option>
              <option value="annet">{t.properties[4]}</option>
            </select>
          </label>
        </div>
        <label>
          <span>{t.existing}</span>
          <select name="existing">
            <option value="">{t.existingPh}</option>
            <option value="ja">{t.existingOpts[0]}</option>
            <option value="nei">{t.existingOpts[1]}</option>
            <option value="usikker">{t.existingOpts[2]}</option>
          </select>
        </label>
        <input type="hidden" name="type" value="" />
        <input type="hidden" name="locale" value={locale} />
        <label><span>{t.message}</span><textarea name="message" required maxlength="4000"></textarea></label>
        <div class="hp" aria-hidden="true">
          <label>{t.honeypot}<input name="website" type="text" tabindex="-1" autocomplete="off" /></label>
        </div>
        <button class="btn" type="submit">{t.submit}</button>
        <p class="form-note">{t.note} <a href={pathFor(locale, "privacy")}>{t.privacy}</a></p>
        <p id="form-status" role="status"></p>
        <noscript>
          <p class="form-note">{t.noscript} <a href={`mailto:${site.email}`} data-track="mailto" translate="no">{site.email}</a>.</p>
        </noscript>
      </form>
    </div>
  </section>
</Base>

<script>
  import { copyFor } from "../i18n/form-copy.js";
  import { buildMailto, parseInquiry } from "../lib/inquiry.js";
  import { track } from "../lib/track.js";

  const form = document.querySelector<HTMLFormElement>("#contact-form");
  const status = document.querySelector<HTMLElement>("#form-status");

  if (form && status) {
    const locale = form.dataset.locale === "en" ? "en" : "nb";
    const copy = copyFor(locale);
    const params = new URLSearchParams(window.location.search);
    const map: Record<string, string> = {
      eksisterende: "eksisterende",
      nytt: "nytt",
      portefolje: "portefolje",
      vurdering: "eksisterende",
      forslag: "nytt",
      butikk: "portefolje",
      kamera: "nytt",
    };
    const chosen = map[params.get("type") || ""] || map[params.get("tema") || ""] || "";
    const typeInput = form.querySelector<HTMLInputElement>('[name="type"]');
    if (typeInput && chosen) typeInput.value = chosen;

    const showMailto = (href: string, email: string) => {
      status.replaceChildren();
      status.append(copy.mailtoIntro);
      const link = document.createElement("a");
      link.href = href;
      link.textContent = email;
      status.append(link);
      status.append(copy.mailtoOutro);
    };

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const email = form.dataset.email || "post@operiq.no";
      const mode = form.dataset.mode || "mailto";
      const raw = Object.fromEntries(new FormData(form).entries());
      const parsed = parseInquiry(raw, locale);

      if (!parsed.ok) {
        status.textContent = parsed.error;
        return;
      }

      if (parsed.spam) {
        form.reset();
        status.textContent = copy.spam;
        return;
      }

      const href = buildMailto(parsed.value, email, locale);
      track("form_submit", { type: parsed.value.type || parsed.value.topic || "", locale });

      if (mode !== "server") {
        showMailto(href, email);
        window.location.href = href;
        return;
      }

      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (button) button.disabled = true;
      status.textContent = copy.sending;

      try {
        const response = await fetch("/api/contact", {
          method: "POST",
          headers: { "content-type": "application/json", accept: "application/json" },
          body: JSON.stringify(raw),
        });
        const payload = await response.json().catch(() => null);
        if (response.ok && payload?.delivered) {
          form.reset();
          status.textContent = copy.delivered;
          return;
        }
        if (response.status === 400 && payload?.error) {
          status.textContent = payload.error;
          return;
        }
      } catch {
        // Static preview has no function. Fall through to mailto.
      } finally {
        if (button) button.disabled = false;
      }

      showMailto(href, email);
      window.location.href = href;
    });
  }
</script>
