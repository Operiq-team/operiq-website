---
/**
 * TODO(eier): Bekreft at post@operiq.no er adressen som skal publiseres.
 * TODO(eier): Salgstelefon settes i src/site.ts (phone). Tom streng skjuler nummeret.
 * TODO(eier): Ingen gateadresse er godkjent. Teksten sier «Basert i Oslo, leverer i hele landet».
 * TODO(eier): contactMode i src/site.ts står på "mailto". Se README før det endres.
 */
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import { site } from "../site";

const title = "Kontakt – Operiq";
const description =
  "Be om vurdering eller løsningsforslag for kameraovervåkning. E-post post@operiq.no. Basert i Oslo, leverer i hele landet.";
const tel = site.phone.replace(/\s/g, "");
---

<Base title={title} description={description} path="/kontakt">
  <PageHero
    kicker="Kontakt"
    title="Få vurdert dagens kameraanlegg"
    lead="Fortell kort om eiendommen. Skjemaet åpner en e-post til oss. Ingenting sendes før du sender e-posten."
  />

  <section class="section section-follow">
    <div class="container contact-grid">
      <aside class="contact-aside">
        <h2>Direkte</h2>
        <p>
          E-post<br />
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </p>
        <p>
          Sted<br />
          {site.coverage}
        </p>
        {
          site.phone && (
            <p>
              Telefon
              <br />
              <a href={`tel:${tel}`}>{site.phone}</a>
            </p>
          )
        }
        <p>Skjemaet åpner e-postprogrammet med ferdig tekst til {site.email}. Henvendelsen lagres ikke på nettsiden. Ingenting er sendt før du sender e-posten.</p>
      </aside>

      <form
        id="contact-form"
        method="post"
        action="/api/contact"
        data-mode={site.contactMode}
        data-email={site.email}
      >
        <div class="form-row two">
          <label>
            <span>Navn</span>
            <input name="name" type="text" autocomplete="name" required maxlength="120" />
          </label>
          <label>
            <span>Firma</span>
            <input name="company" type="text" autocomplete="organization" maxlength="160" />
          </label>
        </div>
        <div class="form-row two">
          <label>
            <span>E-post</span>
            <input name="email" type="email" autocomplete="email" required maxlength="160" />
          </label>
          <label>
            <span>Telefon, valgfritt</span>
            <input name="phone" type="tel" autocomplete="tel" maxlength="40" />
          </label>
        </div>
        <div class="form-row two">
          <label>
            <span>Sted</span>
            <input name="location" type="text" maxlength="240" />
          </label>
          <label>
            <span>Type eiendom</span>
            <select name="propertyType">
              <option value="">Velg, valgfritt</option>
              <option value="naering">Næringsbygg</option>
              <option value="lager">Lager og logistikk</option>
              <option value="portefolje">Eiendomsportefølje</option>
              <option value="butikk">Butikk</option>
              <option value="annet">Annet</option>
            </select>
          </label>
        </div>
        <label>
          <span>Har dere kameraanlegg fra før?</span>
          <select name="existing">
            <option value="">Velg, valgfritt</option>
            <option value="ja">Ja</option>
            <option value="nei">Nei</option>
            <option value="usikker">Usikker</option>
          </select>
        </label>
        <input type="hidden" name="topic" value="" />
        <label>
          <span>Hva trenger dere hjelp til?</span>
          <textarea name="message" required maxlength="4000"></textarea>
        </label>
        <div class="hp" aria-hidden="true">
          <label>
            Nettsted
            <input name="website" type="text" tabindex="-1" autocomplete="off" />
          </label>
        </div>
        <button class="btn" type="submit">Send forespørsel</button>
        <p id="form-status" role="status"></p>
        <noscript>
          <p class="form-note">
            Uten JavaScript sendes skjemaet til serveren. Før utsending er satt opp, får du en
            ferdig e-postlenke tilbake. Du kan også skrive direkte til
            <a href={`mailto:${site.email}`}>{site.email}</a>.
          </p>
        </noscript>
      </form>
    </div>
  </section>
</Base>

<script>
  import { buildMailto, parseInquiry } from "../lib/inquiry.js";

  const form = document.querySelector<HTMLFormElement>("#contact-form");
  const status = document.querySelector<HTMLElement>("#form-status");

  if (form && status) {
    const params = new URLSearchParams(window.location.search);
    const topic = params.get("tema");
    const topicInput = form.querySelector<HTMLInputElement>('[name="topic"]');
    if (topicInput && topic && ["vurdering", "forslag", "portefolje", "kamera", "butikk", "annet"].includes(topic)) {
      topicInput.value = topic;
    }

    const showMailto = (href: string, email: string) => {
      status.replaceChildren();
      status.append("E-postprogrammet åpnes med ferdig tekst til ");
      const link = document.createElement("a");
      link.href = href;
      link.textContent = email;
      status.append(link);
      status.append(". Ingenting er sendt før du sender e-posten.");
    };

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const email = form.dataset.email || "post@operiq.no";
      const mode = form.dataset.mode || "mailto";
      const raw = Object.fromEntries(new FormData(form).entries());
      const parsed = parseInquiry(raw);

      if (!parsed.ok) {
        status.textContent = parsed.error;
        return;
      }

      if (parsed.spam) {
        form.reset();
        status.textContent = "Takk. Vi svarer på e-post.";
        return;
      }

      const href = buildMailto(parsed.value, email);

      if (mode !== "server") {
        showMailto(href, email);
        window.location.href = href;
        return;
      }

      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (button) button.disabled = true;
      status.textContent = "Sender …";

      try {
        const response = await fetch("/api/contact", {
          method: "POST",
          headers: {
            "content-type": "application/json",
            accept: "application/json",
          },
          body: JSON.stringify(raw),
        });
        const payload = await response.json().catch(() => null);
        if (response.ok && payload?.delivered) {
          form.reset();
          status.textContent = "Takk. Vi har mottatt henvendelsen og svarer på e-post.";
          return;
        }
        if (response.status === 400 && payload?.error) {
          status.textContent = payload.error;
          return;
        }
      } catch {
        // Static preview has no function. Fall through to mailto.
      } finally {
        if (button) button.disabled = false;
      }

      showMailto(href, email);
      window.location.href = href;
    });
  }
</script>
