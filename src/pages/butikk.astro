---
import Base from "../layouts/Base.astro";
import CtaBand from "../components/CtaBand.astro";
import { pathFor, ui, type Locale } from "../i18n";

interface Props { locale?: Locale }
const { locale = "nb" } = Astro.props;
const t = ui(locale).retail;
---

<Base title={t.title} description={t.description} path={pathFor(locale, "retail")} locale={locale}>
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <p class="kicker">{t.kicker}</p>
        <h1>{t.h}</h1>
        <p class="lead">{t.lead}</p>
        <div class="actions">
          <a class="btn" href={`${pathFor(locale, "contact")}?type=portefolje`} data-track="primary_cta_click" data-track-type="portefolje">{t.cta}</a>
        </div>
      </div>
      <div class="frame">
        <img src="/img/retail-night.jpg" alt={t.alt1} width="1200" height="900" loading="lazy" decoding="async" />
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <ul class="service-cards">{t.cards.map((card) => <li><h3>{card[0]}</h3><p>{card[1]}</p></li>)}</ul>
    </div>
  </section>
  <section class="section section-alt">
    <div class="container split">
      <div class="frame">
        <img src="/img/building-night.jpg" alt={t.alt2} width="1200" height="900" loading="lazy" decoding="async" />
      </div>
      <div>
        <h2>{t.ownH}</h2>
        <p class="measure">{t.ownP}</p>
        <p><a class="link-arrow" href={pathFor(locale, "secure")}>{t.spec}</a></p>
      </div>
    </div>
  </section>
  <section class="section section-tight">
    <div class="container">
      <CtaBand title={t.ctaTitle} text={t.ctaText} href={`${pathFor(locale, "contact")}?type=portefolje`} label={t.cta} />
    </div>
  </section>
</Base>
