---
import Base from "../layouts/Base.astro";
import CtaBand from "../components/CtaBand.astro";
import PageHero from "../components/PageHero.astro";
import { pathFor, ui, type Locale } from "../i18n";

interface Props { locale?: Locale }
const { locale = "nb" } = Astro.props;
const t = ui(locale).warehouse;
---

<Base title={t.title} description={t.description} path={pathFor(locale, "warehouse")} locale={locale}>
  <PageHero kicker={t.kicker} title={t.h} lead={t.lead} />
  <section class="section section-follow">
    <div class="container">
      <div class="split">
        <div class="frame">
          <img src="/img/warehouse-night.jpg" alt={t.alt} width="1200" height="900" loading="lazy" decoding="async" />
        </div>
        <div>
          <h2>{t.coverH}</h2>
          <ul class="checks">{t.cover.map((item) => <li>{item}</li>)}</ul>
          <p>{t.coverP}</p>
        </div>
      </div>
    </div>
  </section>
  <section class="section section-alt">
    <div class="container">
      <h2>{t.netH}</h2>
      <ul class="service-cards">
        {t.net.map((card) => <li><h3>{card[0]}</h3><p>{card[1]}</p></li>)}
      </ul>
      <p>{t.night}</p>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <h2>{t.moreH}</h2>
      <p>{t.more} <a class="link-arrow" href={pathFor(locale, "portfolio")}>{t.moreLinks[0]}</a> <a class="link-arrow" href={pathFor(locale, "commercial")}>{t.moreLinks[1]}</a></p>
      <p>{t.legal}</p>
    </div>
  </section>
  <section class="section section-tight">
    <div class="container">
      <CtaBand title={t.ctaTitle} text={t.ctaText} href={`${pathFor(locale, "contact")}?type=nytt`} label={t.cta} />
    </div>
  </section>
</Base>
