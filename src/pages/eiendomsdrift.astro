---
/**
 * Avklart: eiendomsdrift er konsulentoppdrag, ikke kontraktsfestet totalansvar for driften.
 * Økonomisk forvaltning og husleieadministrasjon inngår ikke.
 */
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import CtaBand from "../components/CtaBand.astro";
import { site } from "../site";

const title = "Eiendomsdrift for næringsbygg – Operiq";
const description =
  "Konsulentoppdrag innen driftsledelse og teknisk oppfølging av næringseiendom. FDV, internkontroll, leverandører og tekniske prosjekter. Ikke husleie eller økonomiforvaltning.";
---

<Base title={title} description={description} path="/eiendomsdrift">
  <PageHero
    kicker="Eiendomsdrift"
    title="Drift av næringseiendom som konsulentoppdrag"
    lead="Driftsledelse og teknisk oppfølging der Operiq går inn som konsulent og innleid driftsansvarlig. Vi overtar ikke et kontraktsfestet ansvar for hele driften av bygget."
  >
    <p class="lead">{site.coverage}.</p>
    <div class="actions">
      <a class="btn" href="/kontakt?tema=drift">Ta kontakt om drift</a>
    </div>
  </PageHero>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>Arbeidsområder</h2>
        <p>Oppdraget avtales skriftlig. Dette er det vi kan ta.</p>
      </div>
      <ul class="rows">
        <li>
          <h3>Driftsledelse</h3>
          <p>Teknisk oppfølging av bygget, som innleid driftsansvarlig.</p>
        </li>
        <li>
          <h3>FDV og internkontroll</h3>
          <p>FDV-dokumentasjon og internkontroll, fulgt opp som en del av oppdraget.</p>
        </li>
        <li>
          <h3>Leverandører</h3>
          <p>Oppfølging av leverandører som jobber på bygget.</p>
        </li>
        <li>
          <h3>Tekniske prosjekter</h3>
          <p>Prosjektledelse av tekniske oppgraderinger.</p>
        </li>
      </ul>
      <p class="callout">
        <strong>Ikke totalansvar, og ikke økonomi</strong>
        Operiq tar konsulentoppdrag. Vi tar ikke kontraktsfestet ansvar for hele driften. Økonomisk forvaltning og husleieadministrasjon inngår ikke.
      </p>
    </div>
  </section>

  <section class="section section-tight">
    <div class="container">
      <CtaBand
        title="Fortell om bygget"
        text="Hvor det ligger, og hva du vil ha fulgt opp. Vi svarer på om det er et konsulentoppdrag for Operiq."
        href="/kontakt?tema=drift"
        label="Ta kontakt om drift"
      />
    </div>
  </section>
</Base>
