---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { hreflangSet, htmlLang, ogLocale, pageIdFromPath, ui, type Locale } from "../i18n";
import { isPagesPreviewBuild } from "../lib/preview-robots.js";
import { site } from "../site";

interface Props {
  title: string;
  description: string;
  path: string;
  locale?: Locale;
  noindex?: boolean;
  showCta?: boolean;
}

const { title, description, path, locale = "nb", noindex = false, showCta = true } = Astro.props;
const t = ui(locale);
const hideFromIndex = noindex || isPagesPreviewBuild();
const alternates = hreflangSet(pageIdFromPath(path));
const canonical = locale === "en" ? alternates.en : alternates.nb;
const ogImage = new URL("/og.jpg", site.url).href;
const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${site.url}/#organization`,
      name: site.name,
      legalName: site.legalName,
      url: `${site.url}/`,
      email: site.email,
      telephone: site.phone,
      logo: new URL("/brand/logo-white.svg", site.url).href,
      image: ogImage,
      description: t.jsonDescription,
      inLanguage: htmlLang(locale),
      areaServed: { "@type": "Country", name: "Norway" },
      identifier: { "@type": "PropertyValue", name: t.jsonIdName, value: site.orgNr },
    },
    {
      "@type": "Service",
      name: t.jsonService,
      serviceType: t.jsonServiceType,
      provider: { "@id": `${site.url}/#organization` },
      areaServed: { "@type": "Country", name: "Norway" },
      description: t.jsonDescription,
      inLanguage: htmlLang(locale),
    },
  ],
}).replace(/</g, "\\u003c");
---

<!doctype html>
<html lang={htmlLang(locale)} data-locale={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {
      hideFromIndex ? (
        <meta name="robots" content="noindex, nofollow" />
      ) : (
        <link rel="canonical" href={canonical} />
      )
    }
    <link rel="alternate" hreflang="nb-NO" href={alternates.nb} />
    <link rel="alternate" hreflang="en" href={alternates.en} />
    <link rel="alternate" hreflang="x-default" href={alternates.xDefault} />
    <meta name="theme-color" content="#0B1117" />
    <link
      rel="preload"
      href="/fonts/space-grotesk-latin-600-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <meta property="og:locale" content={ogLocale(locale)} />
    <meta property="og:locale:alternate" content={locale === "en" ? "nb_NO" : "en_GB"} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.ogAlt} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-16.png" type="image/png" sizes="16x16" />
    <link rel="apple-touch-icon" href="/apple-touch-icon-180.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <script type="application/ld+json" set:html={jsonLd} />
  </head>
  <body>
    <a class="skip" href="#innhold">{t.skip}</a>
    <Header showCta={showCta} locale={locale} />
    <main id="innhold">
      <slot />
    </main>
    <Footer locale={locale} />
    <script>
      import { track } from "../lib/track.js";

      document.addEventListener("click", (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;
        const el = target.closest("[data-track]");
        if (!(el instanceof HTMLElement)) return;
        const name = el.dataset.track;
        if (!name) return;
        const type = el.dataset.trackType;
        const locale = document.documentElement.dataset.locale === "en" ? "en" : "nb";
        track(name, type ? { type, locale } : { locale });
      });
    </script>
  </body>
</html>
